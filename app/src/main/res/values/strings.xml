    <!-- About Screen -->
    <string name="about_title">About SignBridge AI</string>
    <string name="about_mission_title">Our Mission</string>
    <string name="about_mission_text">SignBridge AI is dedicated to empowering deaf and hard-of-hearing individuals with immediate, accessible communication. By converting nearby spoken words into clear, high-contrast captions on your Android device, you can actively follow face-to-face meetings, lectures, doctor visits, and daily conversations with confidence.</string>
    <string name="about_features_title">Key Features</string>
    <string name="about_feature_1">✓ Real-time Speech-to-Text with partial and final sentence display.</string>
    <string name="about_feature_2">✓ Multilingual support for English, Hindi (हिन्दी), and Marathi (मराठी).</string>
    <string name="about_feature_3">✓ Manual listening control: microphone only activates when you tap Start.</string>
    <string name="about_feature_4">✓ Visual sound level meter and haptic tactile vibration.</string>
    <string name="about_feature_5">✓ Quick Reply Text-to-Speech (TTS) to speak your replies aloud.</string>
    <string name="about_feature_6">✓ 100% On-device conversation history storage with zero mandatory sign-ins.</string>
    <string name="about_privacy_title">Privacy &amp; Transparency</string>
    <string name="about_privacy_text">SignBridge AI does not require account creation, does not track you, and does not store raw audio files. Speech processing is mediated by the device\'s Android SpeechRecognizer engine.</string>

# ============================================================
#  SignBridge AI — .gitignore
#  Excludes build outputs, generated files, local config,
#  secrets, IDE artifacts, and OS junk.
# ============================================================

# ── Built application output ──────────────────────────────
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class

# ── Generated / build directories ────────────────────────
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
gen/
out/
bin/

# ── Local configuration (SDK path, machine-specific) ──────
local.properties

# ── Secrets & credentials — NEVER commit these ────────────
.env
*.jks
*.keystore
debug.keystore
debug.keystore*
*.base64
google-services.json
GoogleService-Info.plist

# ── Android Studio / IntelliJ IDEA ───────────────────────
*.iml
.idea/
*.ipr
*.iws
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# ── Captures / profiling ──────────────────────────────────
/captures

# ── Screenshots & screen recordings (docs/images kept) ───
screenshots/
*.mp4
*.mov
*.avi
*.webm
*.mkv
screen-recording*
screenrecord*

# ── OS-generated files ───────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ── Gradle wrapper (jar kept, caches excluded) ────────────
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ── NPM / Node (not used, but safety net) ────────────────
node_modules/

# ── Temporary files ───────────────────────────────────────
*.tmp
*.bak
*.swp
*~
